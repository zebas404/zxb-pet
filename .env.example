# Copia este archivo a .env y rellena los valores. .env nunca va a git.

# Ruta del vault en el host (la carpeta receive-only de Syncthing en zxb-app01).
VAULT_HOST_PATH=/srv/syncthing/SegundoCerebro
# Puerto publicado en el host (el 3000 ya lo usa el Job Hunter).
ZEBOT_PORT=8000

# Claude API: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
BRIEFING_MAX_REFRESH_PER_DAY=5

# Mascota
PET_NAME=Zebot
# casual | normal | hardcore
PET_DIFFICULTY=normal
TZ=America/Bogota
